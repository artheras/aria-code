{
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "health",
        "create",
        "start",
        "status",
        "wait",
        "stop",
        "obstacle",
        "trace"
      ]
    },
    "goal": {
      "type": "string",
      "description": "User's task goal and constraints, as context; never a shell command."
    },
    "scenario": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "start": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "goal": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "obstacles": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 2,
            "maxItems": 2
          }
        }
      },
      "required": [
        "width",
        "height",
        "start",
        "goal",
        "obstacles"
      ],
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "properties": {
        "max_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "deadline_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 120000
        }
      },
      "additionalProperties": false
    },
    "task_id": {
      "type": "string"
    },
    "request_id": {
      "type": "string",
      "description": "Required only for create/start/obstacle. Stable unique operation ID; reuse only for an identical operation. Omit for health/status/wait/stop/trace."
    },
    "cell": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000,
      "description": "Required only for wait. Maximum 1000ms per call; query again if still running."
    }
  },
  "required": [
    "action"
  ],
  "additionalProperties": false,
  "description": "Goal-directed logical warehouse simulation. Use only fields applicable to the selected action. create: action, request_id, goal, scenario, optional constraints. start: action, task_id, request_id. status/stop/trace: action, task_id ONLY. wait: action, task_id, timeout_ms ONLY. obstacle: action, task_id, request_id, cell. health: action ONLY. Never send request_id to read actions."
}
