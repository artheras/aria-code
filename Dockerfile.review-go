FROM golang:1.27.3-alpine AS build

WORKDIR /src
COPY go/projectreview ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/aria-project-review .

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/aria-project-review /aria-project-review

ENV PORT=8787
ENV ARIA_CODE_WORKSPACE_ROOT=/tmp/aria-code-workspaces
EXPOSE 8787
ENTRYPOINT ["/aria-project-review"]
