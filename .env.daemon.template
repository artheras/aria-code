# ~/.aria/.env — Aria Daemon 环境变量配置
# 复制此文件到 ~/.aria/.env 并填入实际值
# cp .env.daemon.template ~/.aria/.env

# ── Telegram Bot ──────────────────────────────────────────────────────────────
# 1. 在 Telegram 中找 @BotFather, 发送 /newbot
# 2. 获得 token 后填入:
TELEGRAM_BOT_TOKEN=your_bot_token_here

# 你的 Telegram Chat ID (发消息给 @userinfobot 获取)
# 必填：留空 = 谁都不能用。不知道 Chat ID？给机器人发条消息，它会回复你的 ID。
TELEGRAM_ALLOWED_IDS=123456789

# ── 飞书 (Feishu / Lark) ────────────────────────────────────────────────────────
# 方案一：群机器人 Webhook（单向推送，5 分钟完成）
# 飞书群 → 群设置 → 机器人 → 添加机器人 → 自定义机器人 → 复制 Webhook 地址
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxxxxxxxxxx

# 方案二：自建应用（双向，支持 /price /brief /screen 等命令交互）
# 飞书开发者后台 https://open.feishu.cn/app → 创建自建应用
# 凭证与基本信息 → 复制 App ID 和 App Secret
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 事件校验：Encrypt Key 或 Verification Token 至少填一个（开发者后台 → 事件与回调
# → 加密策略）。两个都不填时，独立运行的机器人会拒绝所有事件——否则任何能访问
# 端口的人都能冒充任意发件人。
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=

# 谁能使用机器人：发件人的 open_id（ou_ 开头）或 user_id，英文逗号分隔。
# 必填：留空 = 谁都不能用。不知道自己的 ID？直接私聊机器人，它会回复你的 ID。
FEISHU_ALLOWED_USER_IDS=

# 群聊：一个群对应一个货主。管理员在群里 @机器人 发送 /owner <货主ID> 绑定，
# /owner off 解除。绑定后该群的所有分析只会使用这个货主的数据（由工具层强制）。
# 管理员按渠道列出：feishu:<open_id>，多个用英文逗号分隔。留空 = 没有人能绑定。
ARIA_CHANNEL_ADMINS=
# 每日货主提醒：daemon 按 ARIA_DIGEST_CRON（默认工作日+周六 08:30）给每个绑定了
# 货主的群推送「建议补货 / 历史不足 / 呆滞库存 / 运费待核对 / 可节省线路」，没有
# 需要处理的内容就不发。群里 @机器人 发 /digest（或 /简报）可立即生成一份。
# 数据来源由运维在 JSON 文件里指定（不能从聊天里设置），"*" 是共用的多货主导出：
#   {"ACME": {"inventory": "/data/acme/skus.csv", "waybills": "/data/acme/waybills.csv"},
#    "*":    {"inventory": "/data/wms/all_skus.csv"}}
# 文件里必须有 owner_id 列；没有的会被拒绝，而不是猜它属于谁。
ARIA_SHIPPER_FEEDS=
ARIA_DIGEST_CRON=30 8 * * 1-6

# 审批：群里 @机器人 发送 /补货 会生成一张「采购单草稿」审批卡片，审批人点「批准」
# 后才把草稿 CSV 写进 ARIA_APPROVAL_OUTBOX/<货主>/，供你们自己的采购系统读取；
# Aria 不会自动下单。审批人按渠道列出（管理员默认也是审批人），留空 = 没有人能批。
# 飞书开发者后台 → 事件与回调 → 回调配置：订阅「卡片回传交互」(card.action.trigger)，
# 请求地址与事件订阅相同（中继模式下就是中继的 /feishu/event）。
# 中继模式下本机的凭证：第一次连接中继时自动生成并写进 ~/.aria/.env，不要手填，
# 也不要发给任何人。令牌证明「这台电脑是这台电脑」；绑定码是在飞书里发给
# Aria 的 /bind ARIA-BIND-XXXX-XXXX-XXXX，只有能看到这台电脑屏幕的人知道它。
# ARIA_RELAY_CLIENT_TOKEN=
# ARIA_RELAY_BIND_CODE=
# 中继若设置了 RELAY_SECRET（部署级口令），本机在这里填同一个值：
ARIA_RELAY_SECRET=
# 中继模式：回复、每日提醒和审批卡片都由中继代发，本机不需要飞书应用凭证；中继只
# 允许回复转给本机的消息、只往你和机器人说过话的群里发。图片、语音和文件暂不支持。
ARIA_CHANNEL_APPROVERS=
ARIA_APPROVAL_OUTBOX=

# 机器人自己的 open_id。应用开了「读取群内所有消息」权限时必填，否则机器人会
# 把群里任何 @ 别人的消息都当成在叫它。
FEISHU_BOT_OPEN_ID=

# 机器人默认不能使用需要确认的工具（执行命令、写文件、改文件），因为在飞书里
# 没人能点「同意」。确实需要的在这里逐个列出，例如 write_file。慎用 run_command。
ARIA_BOT_ALLOW_TOOLS=

# 默认推送群 Chat ID（供 POST /api/v1/feishu/webhook 使用）
FEISHU_DEFAULT_CHAT_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Webhook ────────────────────────────────────────────────────────────────────
# TradingView / 外部系统触发 Aria 命令时验证用
WEBHOOK_TOKEN=your_secret_token

# ── Aria 中继服务（Feishu 多用户分发）────────────────────────────────────────────
# 若使用 Aria 中继服务（推荐，无需自建飞书应用）:
# 1. 运行配置向导（中继模式）：生成 ARIA_RELAY_CLIENT_ID 和本机的绑定码
# 2. 在飞书向 Aria Bot 发送向导显示的绑定码: /bind ARIA-BIND-XXXX-XXXX-XXXX
#    （client ID 不能用来绑定；绑定码只显示在你自己的电脑上）
# 3. 启动 daemon，它会自动连接中继

# Arthera 运营的中继。只接受 wss://（连接时会发送本机令牌）；
# 旧版默认的 relay.aria.ai 不是我们的域名，客户端会拒绝连接。
ARIA_RELAY_URL=wss://aria-code-741336310848.europe-west2.run.app/ws
ARIA_RELAY_CLIENT_ID=
ARIA_RELAY_MODE=relay           # relay 或 own_app

# 若自建中继服务器:
# ARIA_RELAY_URL=wss://relay.yourdomain.com

# ── Aria Code 路径 ─────────────────────────────────────────────────────────────
ARIA_CODE_DIR=~/aria-code

# ── FastAPI 后端地址 ────────────────────────────────────────────────────────────
ARIA_API_BASE=http://localhost:8000
