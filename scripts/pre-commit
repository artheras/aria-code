#!/usr/bin/env bash
# Fast pre-commit checks aligned with Route A (Rust + Go + Python).
# Install: ln -sf ../../scripts/pre-commit .git/hooks/pre-commit (or run ./scripts/dev_setup.sh)

set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 0

STAGED="$(git diff --cached --name-only --diff-filter=ACM)"
[ -n "$STAGED" ] || exit 0

fail=0
say() { printf '  %s\n' "$*"; }

PY=".venv/bin/python3"
[ -x "$PY" ] || PY="$(command -v python3 || true)"

echo "▸ pre-commit checks"

if printf '%s\n' "$STAGED" | grep -q '\.rs$'; then
  if command -v cargo >/dev/null 2>&1; then
    if (cd rust && cargo fmt --check >/dev/null 2>&1); then
      say "✓ rustfmt"
    else
      say "✗ cargo fmt --check failed (run: cd rust && cargo fmt)"
      fail=1
    fi
  fi
fi

GO_FILES="$(printf '%s\n' "$STAGED" | grep '\.go$' || true)"
if [ -n "$GO_FILES" ] && command -v gofmt >/dev/null 2>&1; then
  UNFMT="$(gofmt -l $GO_FILES)"
  if [ -z "$UNFMT" ]; then
    say "✓ gofmt"
  else
    say "✗ gofmt needed on: $UNFMT"
    fail=1
  fi
fi

if printf '%s\n' "$STAGED" | grep -q '\.py$'; then
  if [ -n "$PY" ] && "$PY" -m ruff --version >/dev/null 2>&1; then
    if "$PY" -m ruff check . --select E9,F821,F823 -q; then
      say "✓ ruff"
    else
      say "✗ ruff found syntax or undefined-name errors"
      fail=1
    fi
  else
    say "· ruff not installed, skipping Python lint"
  fi
fi

if [ "$fail" -ne 0 ]; then
  echo
  say "Commit blocked. Fix the issues above or bypass with git commit --no-verify."
  exit 1
fi
exit 0
