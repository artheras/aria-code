# Dockerfile.relay — Aria's Feishu relay (Go), the production image
# (cloudbuild.yaml → Cloud Run; docker compose -f docker-compose.prod.yml).
#
# The relay moved from Python (aria_relay_server.py) to Go (go/relay). Same
# endpoints, environment (PORT, DB_PATH, RELAY_STORE, FEISHU_*, RELAY_SECRET,
# MESSAGE_TIMEOUT) and SQLite/Firestore layout, so a deploy keeps every binding
# and machine credential. tests/test_relay_contract.py holds it to the contract.

FROM golang:1.26-bookworm AS build
WORKDIR /src
COPY go/relay/go.mod go/relay/go.sum ./
RUN go mod download
COPY go/relay/*.go ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /aria-relay .
RUN mkdir /data && chown 65532:65532 /data

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /aria-relay /aria-relay
COPY --from=build --chown=65532:65532 /data/ /data/
# Cloud Run sets PORT; compose sets DB_PATH=/data/relay.db on its volume.
ENV PORT=8765 DB_PATH=/tmp/relay.db
EXPOSE 8765
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD ["/aria-relay", "--healthcheck"]
ENTRYPOINT ["/aria-relay"]
