# Dockerfile.relay — Aria 中继服务器
# 用于 docker compose up relay-server

FROM python:3.11-slim

WORKDIR /relay

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# google-cloud-firestore: RELAY_STORE=firestore keeps bindings across deploys.
RUN pip install --no-cache-dir fastapi uvicorn[standard] websockets httpx google-cloud-firestore

# Install Aria's relay module without the CLI's large finance/model dependency
# tree. Runtime dependencies above cover aria_relay_server and relay_store;
# this image does not run the local coding/finance agent.
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir --no-deps .

ENV PYTHONUNBUFFERED=1

EXPOSE 8765

CMD ["python3", "-m", "aria_code.aria_relay_server"]
