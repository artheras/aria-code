# Caddyfile — Aria 中继服务器反向代理
# 替换 relay.yourdomain.com 为你的域名

relay.yourdomain.com {
    # 飞书事件端点 (/feishu/*)、WebSocket 中继 (/ws) 与 /status 都转给 relay。
    # Caddy 2 的 reverse_proxy 会自动透传 WebSocket 升级请求，无需手工设置
    # Connection/Upgrade 头（header_up 也不能写在 transport http 块里——那是
    # 无效配置，Caddy 会拒绝加载）。
    reverse_proxy relay-server:8765

    log {
        output file /var/log/caddy/relay.log
        format json
    }
}
