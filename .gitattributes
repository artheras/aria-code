# Go sources stay LF on every checkout. gofmt treats CRLF as unformatted, so
# on Windows runners (core.autocrlf=true) `gofmt -l` listed every file and the
# Native Go runtime workflow failed before running a single test.
*.go    text eol=lf
go.mod  text eol=lf
go.sum  text eol=lf
# Managed upstream sources are verified byte-for-byte, including on Windows.
src/aria_code/domain/_finance_core/*.py text eol=lf
# Keep the upstream kernel byte-identical, including its final blank line.
src/aria_code/domain/_finance_core/backtest_engine.py whitespace=-blank-at-eof
src/aria_code/datasources/sec_statements.py text eol=lf
